# CLA Assistant — require signed CLA on PRs
#
# Destination: VodouAI/OS → .github/workflows/cla.yml
#
# SETUP (once, before making this a required check):
# 1. Install the "CLA Assistant" GitHub App on VodouAI/OS (or use the action below).
# 2. Create an empty private repo (or gist) for signature storage, OR use the
#    default signatures path documented by contributor-assistant.
# 3. Add repo secret PERSONAL_ACCESS_TOKEN if using a remote signatures store
#    (contents:write on the signatures repo).
# 4. Settings → Branches → require status check "CLA Assistant" (or this workflow name).
#
# Until setup is complete, leave this workflow disabled (rename to cla.yml.disabled)
# or keep it as documentation-only. Do NOT make it required while misconfigured —
# it will block all PRs.
#
# Replaces the previous DCO Signed-off-by check (dco.yml).
name: CLA Assistant

on:
  issue_comment:
    types: [created]
  pull_request_target:
    types: [opened, closed, synchronize]

permissions:
  actions: write
  contents: write
  pull-requests: write
  statuses: write

jobs:
  CLAAssistant:
    runs-on: ubuntu-latest
    steps:
      - name: CLA Assistant
        if: |
          (github.event.comment.body == 'recheck') ||
          (github.event.comment.body == 'I have read the CLA Document and I hereby sign the CLA') ||
          (github.event_name == 'pull_request_target')
        uses: contributor-assistant/github-action@v2.6.1
        env:
          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
          # Optional: PAT with contents:write on a signatures store repo
          # PERSONAL_ACCESS_TOKEN: ${{ secrets.PERSONAL_ACCESS_TOKEN }}
        with:
          path-to-document: https://github.com/VodouAI/OS/blob/main/CLA.md
          remote-organization-name: VodouAI
          remote-repository-name: OS
          # Uncomment after creating a signatures branch/file strategy:
          # path-to-signatures: signatures/cla.json
          allowlist: bot*
