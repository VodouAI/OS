{
  "initial_steps": [
    {
      "args": {},
      "id": "cpu",
      "on_fail": "skip",
      "parallel_group": "probes",
      "server": "mcp-monitor",
      "tool": "get_cpu_info"
    },
    {
      "args": {},
      "id": "mem",
      "on_fail": "skip",
      "parallel_group": "probes",
      "server": "mcp-monitor",
      "tool": "get_memory_info"
    },
    {
      "id": "join_probes",
      "in": [
        "cpu",
        "mem"
      ],
      "kind": "join",
      "min_success": 1,
      "mode": "all_settled",
      "on_partial": "continue_with_warning"
    },
    {
      "depends_on": [
        "join_probes"
      ],
      "id": "brief",
      "prompt": "write one short line about the machine from {cpu, mem}"
    }
  ],
  "schema_version": "1.1",
  "stopping_points": [
    {
      "id": 1,
      "options": {
        "1": {
          "label": "Yes",
          "steps": [],
          "vars": {}
        },
        "2": {
          "label": "No",
          "steps": [],
          "vars": {}
        }
      },
      "title": "save this reading?",
      "type": "menu"
    }
  ]
}
