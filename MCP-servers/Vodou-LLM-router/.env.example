# OI-LLM-Router Configuration

# Anthropic API Key (required)
ANTHROPIC_API_KEY=sk-ant-api03-xxxxx

# Model to use (default: claude-sonnet-4-20250514)
# Options: claude-sonnet-4-20250514, claude-opus-4-20250514, claude-3-haiku-20240307
LLM_MODEL=claude-sonnet-4-20250514

# OI installation path (default: auto-detect)
VODOU_PROJECT_PATH=

# Max tokens for routing decision (default: 1024)
MAX_TOKENS=1024
