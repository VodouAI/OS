{
  "name": "vodou-console",
  "version": "1.0.0",
  "description": "Vodou-Console - AI gateway service connecting channels to Claude with Vodou tool use",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "qa:cli": "node scripts/cli-qa.mjs",
    "start": "node dist/index.js",
    "dev": "tsc --watch",
    "sync-skill-servers": "node scripts/sync-skill-servers.js",
    "validate-presets": "node scripts/validate-presets.mjs",
    "vendor:openrouter-models": "node scripts/vendor-openrouter-models.mjs",
    "postinstall": "chmod +x node_modules/node-pty/prebuilds/darwin-arm64/spawn-helper 2>/dev/null || true",
    "gen:core-api": "openapi-typescript http://127.0.0.1:8766/openapi.json -o src/core-api.ts"
  },
  "keywords": [
    "mcp",
    "gateway",
    "ai",
    "claude",
    "anthropic",
    "tool-use",
    "streaming",
    "vodou"
  ],
  "engines": {
    "node": ">=24.0.0 <25.0.0"
  },
  "author": "Vodou",
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@googleapis/chat": "^13.0.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "cheerio": "^1.2.0",
    "cron-parser": "^5.5.0",
    "dotenv": "^16.4.5",
    "express": "^4.18.2",
    "ink": "^5.0.1",
    "ink-spinner": "^5.0.0",
    "ink-text-input": "^6.0.0",
    "node-pty": "^1.1.0",
    "openapi-fetch": "^0.13.8",
    "react": "^18.3.1",
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^24.12.2",
    "@types/react": "^18.3.12",
    "@xterm/headless": "^5.5.0",
    "@types/supertest": "^7.2.0",
    "@types/ws": "^8.5.10",
    "ajv": "^8.18.0",
    "ajv-formats": "^2.1.1",
    "openapi-typescript": "^7.13.0",
    "supertest": "^7.2.2",
    "typescript": "^5.0.0",
    "vitest": "^3.2.4"
  }
}
