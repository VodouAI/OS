# =============================================================================
# Vodou-Console — .env.example
# NOTE: The gateway reads .env from the PROJECT ROOT (../../.env), not this dir.
# Full template with generated comments: ../../.env.example (npm run sync-env-example).
#
# Binary swap / daemon auto-ensure (also set in root .env — same process env):
#   VODOU_GATEWAY_AUTO_ENSURE=0 — disables gateway startup + 60s daemon/worker ensure
#   VODOU_HOOK_SKIP_ENSURE=1 — vodou-hook `ensure` becomes no-op (requires matching vodou-hook-bin)
# =============================================================================

# Required: Anthropic API key for Claude (only needed for anthropic SDK provider)
# ANTHROPIC_API_KEY=sk-ant-api03-xxxxx

# Web server port (default: 8765)
WEB_PORT=8765

# LLM provider: claude-cli | anthropic | openai | google | ollama | groq | deepseek | xai | mistral | custom
LLM_PROVIDER=claude-cli

# Model settings (DB settings take priority over these — these are fallbacks)
# CLI_MODEL=opus
CLAUDE_MODEL=claude-sonnet-4-20250514
OPENAI_MODEL=gpt-4o
GOOGLE_MODEL=gemini-2.5-flash
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
# LM Studio (local, OpenAI-compatible GUI runtime — no API key)
LMSTUDIO_BASE_URL=http://localhost:1234
LMSTUDIO_MODEL=
# Bundled llama.cpp (Vodou Local). Port is ours (override with VODOU_LLAMACPP_PORT);
# model is a HuggingFace -hf ref like ggml-org/Qwen2.5-3B-Instruct-GGUF:Q4_K_M
LLAMACPP_MODEL=
# VODOU_LLAMACPP_PORT=11436

# Max tokens for Claude response (default: 4096)
MAX_TOKENS=4096

# Vodou project root (default: auto-detect from ../../../)
# VODOU_PROJECT_PATH=

# Path to vodou-core binary (default: ./vodou-core)
# VC_PATH=./vodou-core

# Show raw Vodou wrapper tags in prompts/history (default: 0/off).
# When 0, gateway strips <oi_results> wrappers and sends plain "Vodou execution results" context.
VODOU_SHOW_RAW_RESULTS=0

# Gateway shell mode: controls what tools the AI can use in gateway chat.
#   restricted — Bash only, limited to vodou-core commands (safest for multi-user)
#   verify     — Bash + Read/Grep/Glob (read-only investigation)
#   full       — Full Claude Code parity: Bash/Read/Write/Edit/Grep/Glob (default)
# VODOU_GATEWAY_SHELL_MODE=full
# VODOU_GATEWAY_LIST_TOOLS_LIVE=0   # optional; only "1" enables slow live MCP catalog (see executor.ts)
# VODOU_GATEWAY_DISABLE_PERSISTENT_CLI=0   # optional; "1" disables pooled claude -p (slower)

# CLI pool recycling: restart persistent claude -p subprocess when cached prefix
# exceeds this many tokens. Prevents unbounded context growth + rate limit burn.
# Set to 0 to disable. Default: 500000
# VODOU_GATEWAY_POOL_TOKEN_BUDGET=500000

# CLI pool idle timeout (ms). Subprocess killed after this much inactivity. Default: 600000 (10 min)
# VODOU_GATEWAY_CLI_POOL_IDLE_MS=600000

# CLI per-turn wall clock timeout (ms). 0 = disabled. Default: 900000 (15 min)
# VODOU_GATEWAY_CLI_TURN_TIMEOUT_MS=900000

# Smart Model Routing (simple queries -> cheap model, complex -> primary)
# VODOU_SMART_ROUTING=1
# VODOU_SMART_ROUTING_MODEL=

# OpenAI-Compatible API (/v1/chat/completions)
# Set a token to require Bearer auth on /v1 endpoints. Leave unset for open localhost access.
# VODOU_OPENAI_COMPAT_TOKEN=your-secret-token-here

# Gateway memory flush — every N assistant replies (default: 15)
# VODOU_FLUSH_EVERY_N_PROMPTS=15

# --- Gateway OAuth (Apps) ----------------------------------------------------------------
# Browser-visible base URL used for OAuth redirect URIs. Must match exactly what you
# register as "Authorized redirect URIs" in Google Cloud Console (or GitHub OAuth App).
# NOT the same as VODOU_GATEWAY_URL (internal scheduler/worker URL).
GATEWAY_BASE_URL=http://localhost:8765

# Google OAuth — Web application client (console.cloud.google.com → APIs & Services → Credentials)
# Register: ${GATEWAY_BASE_URL}/api/oauth/callback as an Authorized redirect URI
# Enable: Google Calendar API + Google Drive API in the same project
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# GitHub OAuth App (github.com → Settings → Developer settings → OAuth Apps)
# Callback URL to register: ${GATEWAY_BASE_URL}/api/oauth/callback
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# Optional: override where gateway.db lives (default: MCP-servers/Vodou-Console/gateway.db)
# GATEWAY_DB_PATH=/absolute/path/to/gateway.db

# --- Channel attachments (WhatsApp etc.) — read from PROJECT ROOT .env, not this file ---
# WHATSAPP_AUTH_DIR defaults to <VODOU_PROJECT_PATH>/.vodou/whatsapp-auth (see Vodou-channels whatsapp.ts).
# CHANNEL_MEDIA_STRICT=1
# Comma-separated; use double quotes around the whole value if a path has spaces.
# CHANNEL_MEDIA_ROOTS="/path/with spaces/project/.vodou/whatsapp-auth,/tmp"
# CHANNEL_MEDIA_ROOTS=/absolute/path/to/project/.vodou/whatsapp-auth,/private/tmp,/tmp
# CHANNEL_VISION_MAX_BYTES=5242880
# CHANNEL_DOCUMENT_MAX_BYTES=15728640
# CHANNEL_TEXT_ATTACHMENT_MAX_BYTES=1048576
# CHANNEL_VISION_COMPAT_ENDPOINTS=
# CHANNEL_OLLAMA_VISION=0
