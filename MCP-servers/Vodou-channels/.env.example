# Vodou-Channels Configuration
#
# Channel credentials (Telegram/Slack/Discord/WhatsApp bot tokens, IDs, etc.)
# are NO LONGER managed here — they live in the gateway DB and are edited via
# the Settings → Channels → (credentials card) UI. That path is the only one
# the gateway read path actually consults on send.
#
# Only keep non-secret runtime config (ports, feature flags, paths) here.

# ============================================
# VOICE
# ============================================
# Voice engine: "say" (macOS), "espeak" (Linux), "sapi" (Windows)
VOICE_ENGINE=say

# Voice name (platform-specific)
VOICE_NAME=

# ============================================
# WEB INTERFACE
# ============================================
# Port for web interface (default 8766 to avoid conflict with Vodou-Console on 8765)
WEB_PORT=8766

# ============================================
# VODOU INTEGRATION
# ============================================
# Path to Vodou project root (auto-detected if not set)
VODOU_PROJECT_PATH=

# Slack/Telegram/Discord attachment downloads for gateway vision (default: <VODOU_PROJECT_PATH>/.vodou/channel-attachments)
# VODOU_CHANNEL_ATTACHMENTS_DIR=

# ============================================
# CHANNEL RUNTIME FLAGS (optional)
# ============================================
# iMessage poll interval — how often to check chat.db for new messages (ms)
# IMESSAGE_POLL_INTERVAL_MS=2000
# Include Continuity SMS alongside iMessage (default on)
# IMESSAGE_INCLUDE_SMS=1
# Allow group chats (default off)
# IMESSAGE_ALLOW_GROUPS=0
# WhatsApp bridge + webhook ports
# WHATSAPP_BRIDGE_PORT=8081
# WHATSAPP_WEBHOOK_PORT=8082
# WhatsApp auth dir override (default <VODOU_PROJECT_PATH>/.vodou/whatsapp-auth)
# WHATSAPP_AUTH_DIR=
# WhatsApp: allow group chats
# WHATSAPP_ALLOW_GROUPS=0
# Telegram admin ID (informational — used only to suppress first-message logging)
# TELEGRAM_ADMIN_ID=
# Slack: on connect, call users.list to fill the display-name cache (needs **users:read**). Optional; per-message users.info still works without it.
# SLACK_PREFETCH_USERS=1

# ============================================
# GOOGLE CHAT (optional — credentials usually from gateway DB)
# ============================================
# Service account JSON (full object as one line). Required for standalone googlechat.
# GOOGLE_CHAT_CREDENTIALS=
# HTTP port for POST /api/googlechat (default 3979)
# GOOGLE_CHAT_PORT=3979

# ============================================
# SIGNAL (optional — number usually from gateway DB)
# ============================================
# Registered Signal account (E.164). Required for standalone signal.
# SIGNAL_PHONE_NUMBER=+15551234567
# Path to signal-cli if not on PATH
# SIGNAL_CLI_PATH=signal-cli
# Optional signal-cli --config directory
# SIGNAL_CLI_CONFIG=
