  "license": "MIT",
  "engines": {
    "node": ">=22.13.0 <25.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "d3": "^7.9.0"
  },
  "devDependencies": {
    "@types/node": "^24.12.2",
    "typescript": "^5.0.0"
  }
}
