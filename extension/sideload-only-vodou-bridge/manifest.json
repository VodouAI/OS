{
  "manifest_version": 3,
  "name": "Vodou Bridge",
  "version": "0.5.97.66",
  "description": "Never re-explain yourself to an AI again. Turn your chats into memory you own \u2014 on your computer, inserted where you choose.",
  "permissions": [
    "sidePanel",
    "scripting",
    "tabs",
    "storage",
    "alarms",
    "cookies",
    "contextMenus"
  ],
  "host_permissions": [
    "https://policy.vodou.ai/*",
    "http://localhost/*",
    "http://127.0.0.1/*",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*",
        "https://aistudio.google.com/*",
        "https://www.perplexity.ai/*",
        "https://perplexity.ai/*",
        "https://grok.com/*",
        "https://chat.deepseek.com/*",
        "https://copilot.microsoft.com/*",
        "https://chat.mistral.ai/*",
        "https://www.meta.ai/*",
        "https://meta.ai/*",
        "https://manus.im/*",
        "https://*.manus.im/*",
        "https://x.com/*",
        "https://twitter.com/*",
        "https://www.qwen.ai/*",
        "https://qwen.ai/*",
        "https://chat.qwen.ai/*",
        "https://kimi.com/*",
        "https://www.kimi.com/*",
        "https://kimi.moonshot.cn/*",
        "https://notebooklm.google.com/*",
        "https://notebook.google.com/*",
        "https://poe.com/*",
        "https://duckduckgo.com/*",
        "https://duck.ai/*",
        "https://huggingface.co/chat*",
        "https://you.com/*",
        "https://chat.z.ai/*",
        "https://t3.chat/*",
        "https://openrouter.ai/*",
        "https://character.ai/*",
        "https://old.character.ai/*"
      ],
      "js": ["sites.js", "content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*",
        "https://aistudio.google.com/*",
        "https://www.perplexity.ai/*",
        "https://perplexity.ai/*",
        "https://grok.com/*",
        "https://chat.deepseek.com/*",
        "https://copilot.microsoft.com/*",
        "https://chat.mistral.ai/*",
        "https://www.meta.ai/*",
        "https://meta.ai/*",
        "https://manus.im/*",
        "https://*.manus.im/*",
        "https://x.com/*",
        "https://twitter.com/*",
        "https://www.qwen.ai/*",
        "https://qwen.ai/*",
        "https://chat.qwen.ai/*",
        "https://kimi.com/*",
        "https://www.kimi.com/*",
        "https://kimi.moonshot.cn/*",
        "https://notebooklm.google.com/*",
        "https://notebook.google.com/*",
        "https://poe.com/*",
        "https://duckduckgo.com/*",
        "https://duck.ai/*",
        "https://huggingface.co/chat*",
        "https://you.com/*",
        "https://chat.z.ai/*",
        "https://t3.chat/*",
        "https://openrouter.ai/*",
        "https://character.ai/*",
        "https://old.character.ai/*"
      ],
      "js": [
        "inject.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_title": "Vodou Bridge",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "commands": {
    "toggle-side-panel": {
      "suggested_key": {
        "default": "Ctrl+Shift+M",
        "mac": "MacCtrl+Shift+M"
      },
      "description": "Open the Vodou memory panel"
    },
    "inject-context": {
      "suggested_key": {
        "default": "Ctrl+B",
        "mac": "MacCtrl+B"
      },
      "description": "Add relevant Vodou memory to this chat"
    },
    "inject-visible": {
      "suggested_key": {
        "default": "Ctrl+Shift+B",
        "mac": "MacCtrl+Shift+B"
      },
      "description": "Add memory visibly to the composer (any supported site)"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "minimum_chrome_version": "116"
}