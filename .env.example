# =============================================================================
# OI / Vodou -- environment template
# Copy to .env and fill in values. Comment blocks are generated from
# MCP-servers/Vodou-Console/src/api/env-descriptions.json (run: npm run sync-env-example).
# https://app.vodou.ai for VODOU_TOKEN / VODOU_USER_ID
# =============================================================================

# =============================================================================
# CREDENTIALS -- API keys, tokens, secrets
# =============================================================================

# VODOU_TOKEN -- Your Vodou cloud API token from https://app.vodou.ai. Used when features
# need to authenticate against Vodou services (licensing, cloud sync, or account-linked
# behavior). Keep this secret like a password. If you are fully offline/local-only, you
# may leave it empty depending on what you use.
VODOU_TOKEN=

# VODOU_USER_ID -- Your Vodou cloud user identifier, paired with VODOU_TOKEN. Together
# they tell Vodou which account you are. Set both from the same place you got your token.
# Not your email—usually an opaque id string.
VODOU_USER_ID=

# VODOU_USER_EMAIL -- Your email for local continuity / self-principal seeding (continuity
# init, resolver). Not sent to Vodou cloud unless a feature explicitly uses it—primarily
# for display name and stable "you" identity in vodou-core.db. Optional but recommended if
# you want the self-principal to match your real address.
# VODOU_USER_EMAIL=

# VODOU_USER_NAME -- Display name paired with VODOU_USER_EMAIL for the seeded
# self-principal (e.g. how "You" appears in principals). Optional.
# VODOU_USER_NAME=

# GH_TOKEN -- A GitHub personal access token (classic or fine-grained) used when
# automation or MCP tools call the GitHub API (repos, PRs, issues). Create one in GitHub
# -> Settings -> Developer settings. Scope it to what you need (repo read/write, etc.).
# GH_TOKEN=

# ANTHROPIC_API_KEY -- API key from console.anthropic.com when you use the Anthropic API
# provider in the gateway (direct API billing). This is separate from Claude Max / Claude
# CLI, which uses the claude binary login instead. If you only use Claude CLI with a
# subscription, you often do not need this.
# ANTHROPIC_API_KEY=

# OPENAI_API_KEY -- API key from platform.openai.com for OpenAI models (GPT-4o, o3, etc.)
# when OpenAI is selected as the gateway's LLM provider. Charged per token on your OpenAI
# account.
# OPENAI_API_KEY=

# OPENROUTER_API_KEY -- API key from openrouter.ai when using OpenRouter as the LLM
# provider (gateway and some extraction paths). Used with OpenRouter model ids (e.g.
# openai/gpt-4o). Keep secret.
# OPENROUTER_API_KEY=

# FIREWORKS_API_KEY -- API key from fireworks.ai when using Fireworks as the LLM provider.
# Hosted Kimi K2.6 + DeepSeek + Llama with ZDR by default on open models. Keep secret.
# FIREWORKS_API_KEY=
# FIREWORKS_MODEL=accounts/fireworks/models/kimi-k2p6

# GEMINI_API_KEY -- API key from Google AI Studio (aistudio.google.com) for Gemini models
# when Google is the selected provider. Distinct from Google Cloud "API key" in some
# setups—use the AI Studio key the gateway expects.
# GEMINI_API_KEY=

# GROQ_API_KEY -- API key from console.groq.com. Groq hosts very fast inference for many
# open models; used when Groq is your provider.
# GROQ_API_KEY=

# DEEPSEEK_API_KEY -- API key from DeepSeek's platform when DeepSeek is your chat
# provider.
# DEEPSEEK_API_KEY=

# MISTRAL_API_KEY -- API key from console.mistral.ai when Mistral is your provider.
# MISTRAL_API_KEY=

# XAI_API_KEY -- API key from xAI's console when using Grok models as your provider.
# XAI_API_KEY=

# TELEGRAM_BOT_TOKEN -- Token from @BotFather on Telegram (format like 123456:ABC…).
# Required for the Vodou-channels Telegram bot: it is how Telegram routes messages to your
# bot process.
# TELEGRAM_BOT_TOKEN=

# TELEGRAM_ADMIN_ID -- Numeric Telegram user id (not @username) for users allowed to run
# admin-style bot commands. Helps lock down who can control the bot beyond normal chat.
# TELEGRAM_ADMIN_ID=

# SLACK_BOT_TOKEN -- Bot token starting with xoxb- from your Slack app. Used with Socket
# Mode in Vodou-channels so the bot can read/post in workspaces you installed it into.
# SLACK_BOT_TOKEN=

# SLACK_APP_TOKEN -- App-level token starting with xapp- required for Slack Socket Mode
# (websocket connection). Different from the bot token; both are usually needed for the
# socket bot.
# SLACK_APP_TOKEN=

# SLACK_SIGNING_SECRET -- Signing secret from the Slack app "Basic Information" page. Used
# to verify that incoming HTTP requests really came from Slack (when you use HTTP
# endpoints instead of or in addition to sockets).
# SLACK_SIGNING_SECRET=

# SLACK_DEFAULT_CHANNEL -- Default channel id (e.g. C0123…) or name used when a message
# does not specify a channel—so broadcasts or scripts have a sensible target.
# SLACK_DEFAULT_CHANNEL=

# SLACK_TOKEN -- User or workspace token for the Slack MCP integration (search/send
# tools), which is separate from the Vodou-channels bot. Follow that MCP server's docs for
# which token type to use.
# SLACK_TOKEN=

# SLACK_COOKIE -- Browser cookie string some Slack MCP workflows use for authenticated
# browser-style access. Highly sensitive—treat like a password and rotate if leaked.
# SLACK_COOKIE=

# DISCORD_BOT_TOKEN -- Discord bot token from the Discord Developer Portal. Powers the
# Vodou-channels Discord bot so it can connect to your guild and receive/send messages.
# DISCORD_BOT_TOKEN=

# DISCORD_GUILD_ID -- The numeric "server" id of your Discord guild. Used to scope bot
# behavior to one server and avoid acting globally by mistake.
# DISCORD_GUILD_ID=

# DATABASE_TYPE -- Hint for optional graph or code-graph features (e.g. neo4j). Only
# matters if you use tooling that connects to Neo4j or similar; ordinary chat and MCP do
# not require it.
# DATABASE_TYPE=neo4j

# NEO4J_URI -- Bolt connection URL for Neo4j, typically bolt://localhost:7687 or a cloud
# host. Used when CodeGraph or related features query a graph database.
# NEO4J_URI=bolt://localhost:7687

# NEO4J_USERNAME -- Username Neo4j expects for authentication (often neo4j locally).
# NEO4J_USERNAME=neo4j

# NEO4J_PASSWORD -- Password for the Neo4j user. Stored in plain text in .env—protect the
# file.
# NEO4J_PASSWORD=

# NEO4J_DATABASE -- Which Neo4j database name to use inside the server (default is often
# neo4j).
# NEO4J_DATABASE=neo4j

# GOOGLE_OAUTH_CREDENTIALS -- Absolute path to the Google OAuth client JSON (Desktop or
# Web client credentials from Google Cloud Console). Used by presets such as Google
# Calendar MCP—not the same as GEMINI_API_KEY. Keep the file outside public web roots.
# GOOGLE_OAUTH_CREDENTIALS=

# =============================================================================
# SYSTEM -- process limits, paths, feature flags
# =============================================================================

# VODOU_PROJECT_PATH -- Absolute path to this Vodou install (folder containing vodou-core,
# .vodou, etc.). Installers set this so hooks, gateway, and daemons agree on the project
# root even if you start commands from another directory. Wrong path causes wrong DB,
# wrong memory, or missing .vodou files.
# VODOU_PROJECT_PATH="/path/to/your/Vodou"

# VODOU_MAX_PROCESSES -- Maximum number of concurrent vodou-core child processes. The
# scheduler backs off near ~80% of this cap and the agent near ~60% so interactive use
# keeps headroom. The daemon can reap stuck processes after a timeout. Raise if you run
# many parallel tools; lower if the machine is small.
# VODOU_MAX_PROCESSES=10

# VODOU_ALLOW_HEADLESS_BRAIN -- When set to 1, the brain / ./oi command is allowed to run
# without a TTY (e.g. from Cursor, Claude Code, or scripts). Default behavior may exit
# immediately in non-interactive contexts to avoid hangs—this overrides that so automation
# works.
VODOU_ALLOW_HEADLESS_BRAIN=1

# LLM_PROVIDER -- Legacy/default hint for which LLM backend to use (e.g. claude-cli). The
# web gateway usually prefers settings stored in its SQLite gateway.db, so this mainly
# affects CLI paths or fallbacks. Check Settings -> LLM/Model for the live provider.
# LLM_PROVIDER=claude-cli

# CLI_MODEL -- Default Claude CLI model short name (e.g. sonnet, opus, haiku) when the
# gateway database does not override cli_model. Gateway Settings normally wins once
# configured.
# CLI_MODEL=opus

# WEB_PORT -- TCP port where Vodou-Console listens for HTTP/WebSocket (chat UI, REST).
# Default 8765. After changing, restart the gateway; anything bookmarked to the old port
# must be updated. NOTE: this is the GATEWAY port only — the Vodou-channels web channel
# uses its OWN var (VODOU_WEB_CHANNEL_PORT) so it can never collide with the gateway.
# WEB_PORT=8765   # left unset on purpose — install-prebuilt.sh auto-assigns a free port

# VODOU_WEB_CHANNEL_PORT -- Port for the Vodou-channels "web" channel server. Default
# 8770 — deliberately separate from the gateway (8765) and core API (8766). Do NOT point
# this at WEB_PORT; the channel binds 127.0.0.1 and reading the gateway's WEB_PORT used to
# make it shadow the gateway over IPv6.
# VODOU_WEB_CHANNEL_PORT=8770

# START_AIGATEWAY -- When 1, start-vodou-services.sh starts the Node gateway on WEB_PORT.
# When 0, the script skips starting the web UI (you might run the gateway manually or not
# use it).
START_AIGATEWAY=1

# VODOU_GATEWAY_AUTO_ENSURE -- When 0, false, no, or off, the gateway does not run
# vodou-core daemon ensure / worker ensure on startup or on the 60s timer — avoids
# respawning daemon/worker while you replace vodou-core (macOS UE risk). Stale socket
# cleanup still runs. Remove or set to 1 after swapping the binary and restart the
# gateway. Alias: `VODOU_GATEWAY_AUTO_ENSURE.
# VODOU_GATEWAY_AUTO_ENSURE=1

# VODOU_HOOK_SKIP_ENSURE -- When 1 / true / yes / on, vodou-hook-bin ensure becomes a
# no-op (does not spawn the daemon). Pair with VODOU_GATEWAY_AUTO_ENSURE=0 during binary
# swaps; rebuild vodou-hook-bin after changing hook sources. Requires the variable in the
# environment of the vodou-hook process (project .env is loaded by hooks/gateway when
# configured).
# VODOU_HOOK_SKIP_ENSURE=0

# VODOU_GATEWAY_SHELL_MODE -- Controls which tools the AI may use inside gateway chat:
# restricted = bash limited to vodou-core-related commands (safest on shared machines);
# verify = adds read-only file tools (Read/Grep/Glob); full = Claude Code–style tool
# parity including write/edit. Misconfiguration can expose filesystem—use restricted if
# unsure.
# VODOU_GATEWAY_SHELL_MODE=full

# VODOU_GATEWAY_POOL_TOKEN_BUDGET -- For pooled Claude CLI sessions: when cumulative
# "cache read" tokens exceed this number, the gateway recycles (restarts) that CLI process
# so the in-memory context does not grow without bound (saves cost and avoids huge
# prompts). Default 500000; set 0 to disable recycling (not usually recommended).
# VODOU_GATEWAY_POOL_TOKEN_BUDGET=500000

# VODOU_COMPAT_STABLE_PREFIX -- (PLAN-GATEWAY-STATE-LAYER WS2) When 1, the OpenAI-compat
# path (Fireworks/kimi/DeepSeek/managed-proxy) sends a BYTE-STABLE request front every turn
# so the provider prompt-caches [system + tool-defs] (cached input is ~50% off on Fireworks).
# It (a) always re-sends the stable workspace bootstrap, (b) relocates the query-dependent
# memory out of the system message into a late turn, and (c) sets a per-conversation session
# -affinity key (`user`) so multi-replica serverless routes to the warm replica. OFF by default.
# Verify with the [cache] log on a WARM 3-4-turn conversation (expect a ~2-turn cache warm-up).
# VODOU_COMPAT_STABLE_PREFIX=1

# VODOU_TOKEN_DIAG -- Set to 0 to silence the per-turn [token-budget] / [cache] diagnostic
# logs on the OpenAI-compat path. Any other value (or unset) leaves them ON (cheap, invaluable
# when cache/cost behavior drifts). Companion to VODOU_TURN_TOKEN_WARN.
# VODOU_TOKEN_DIAG=1

# VODOU_TURN_TOKEN_WARN -- Cumulative per-turn input-token threshold (OpenAI-compat path) above
# which a loud [token-budget] warning is logged. Observability only (no cut until WS6). Default 120000.
# VODOU_TURN_TOKEN_WARN=120000

# VODOU_TURN_TOKEN_BUDGET -- (PLAN-GATEWAY-STATE-LAYER WS6) Hard per-turn input ceiling that
# actually CUTS the OpenAI-compat tool loop (TURN_TOKEN_WARN only logs). When cumulative input
# billed across a turn's tool rounds crosses this, the loop ends early (after >=1 round) and
# streams a final answer from the context gathered so far, logging loudly. Backstop for runaway
# agentic turns (the 273K-balloon) that WS4/WS5 miss. Default 0 = disabled (opt-in). Try 250000.
# VODOU_TURN_TOKEN_BUDGET=250000

# VODOU_TOOL_RESULT_CAP -- (PLAN-GATEWAY-STATE-LAYER WS4) Char cap for inline tool results that
# the model must read (list_available_tools / board_show). Above the cap, the head is kept inline
# and the FULL blob is parked out-of-band (.vodou/tool-results/) with an `expand_result(id)` handle,
# so it is NOT re-sent every tool iteration (kills the 273K-balloon multiplier). Default 16000.
# VODOU_TOOL_RESULT_CAP=16000

# VODOU_SDK_CACHE_CONTROL -- (PLAN-GATEWAY-STATE-LAYER WS3) Default ON. Adds Anthropic
# prompt-cache breakpoints (cache_control: ephemeral) to the direct `anthropic` SDK
# provider's system block + tool defs, so a BYOK-Anthropic user gets ~90%-off cache reads
# on the stable prefix (the claude-CLI path already caches natively; this closes the SDK
# gap). No-op for non-Anthropic providers. Set to 0 to disable.
# VODOU_SDK_CACHE_CONTROL=0

# VODOU_COGS_GOVERNOR -- (PLAN-COGS-GOVERNOR) Default OFF. When 1, the managed (vodou) tier
# derives a per-turn cost envelope from the plan/quota signal already fetched each turn
# (checkQuota) and uses it to tune the state-layer knobs: tool-loop depth, output cap, WS6
# token budget, WS4 tool-result cap, WS5 rolling summary. Free / near-limit turns get a tighter
# envelope (and a graceful glide-path before the hard limit); paid 'ok' turns are unchanged.
# It only SHAPES spend (the proxy/app-box still enforce the dollar limit). OFF = identical to today.
# VODOU_COGS_GOVERNOR=1
# Per-tier knob overrides (defaults shown): VODOU_COGS_FREE_MAX_ITERS=5 VODOU_COGS_FREE_BUDGET=80000
# VODOU_COGS_FREE_CAP=8000 VODOU_COGS_FREE_MAX_TOKENS=4096 VODOU_COGS_WARNING_MAX_ITERS=6
# VODOU_COGS_WARNING_BUDGET=120000 VODOU_COGS_WARNING_CAP=10000 VODOU_COGS_LOW_MAX_ITERS=8
# VODOU_COGS_LOW_BUDGET=180000 VODOU_COGS_LOW_FLOOR_PCT=0.15

# VODOU_AGENT_MODE -- (PLAN-AGENT-LOOP Phase 1) Default OFF. When 1, the in-process tool loop
# runs DEEPER: the per-turn iteration ceiling rises from MAX_TOOL_ITERATIONS (10) to
# VODOU_AGENT_MAX_ITERS (40), plus a Hermes-style budget = one grace round + a REFUND for
# all-cheap (read-only) rounds (read_file/grep/glob/file_stat/directory_tree/search_files/
# expand_result) so deep turns don't burn their depth on file reads. Applies to every API
# provider path (SDK + OpenAI-compat + Ollama); the CLI agents (claude-cli/kimi-cli) run their
# own loop via --max-turns instead. The COGS governor (above) still CLAMPS the ceiling per tier
# (free->5, warning->6, low->8) — agent mode raises the paid 'ok' ceiling, it cannot make a free
# turn more expensive than its tier allows. OFF = identical to today.
# VODOU_AGENT_MODE=1
# VODOU_AGENT_MAX_ITERS=40

# VODOU_ROLLING_SUMMARY -- (PLAN-GATEWAY-STATE-LAYER WS5) Default OFF. When 1, long
# conversations that cross the compaction threshold replace older turns with a REAL
# LLM-generated rolling summary (refreshed in the background every
# VODOU_ROLLING_SUMMARY_EVERY messages, default 6) instead of the naive first-N-chars
# truncation — keeps long chats both bounded AND coherent. Lossy by design; falls back to
# the naive summary until the first refresh lands and on any LLM failure. OpenAI-compat +
# Ollama paths.
# VODOU_ROLLING_SUMMARY=1
# VODOU_ROLLING_SUMMARY_EVERY=6

# VODOU_GATEWAY_POOL_RESTART_ON_SYSTEM_PROMPT_CHANGE -- When 1 or true, restarting or
# changing the system prompt for a pooled Claude CLI session forces a new CLI process
# instead of reusing the old one. Use if you need a clean system context after prompt
# tweaks; otherwise leave unset/false for fewer restarts.
# VODOU_GATEWAY_POOL_RESTART_ON_SYSTEM_PROMPT_CHANGE=1

# VODOU_SMART_ROUTING -- Default on (anything other than 0/false). Sends "simple" user
# queries to a cheaper/faster model and keeps hard tasks on your primary model. Set to 0
# to disable so every message uses the primary model only.
# VODOU_SMART_ROUTING=1

# VODOU_SMART_ROUTING_MODEL -- Override the cheap-route model id. Empty = automatic per
# provider (e.g. Haiku for Anthropic, mini models for OpenAI). Set explicitly if you want
# a particular small model.
# VODOU_SMART_ROUTING_MODEL=

# VODOU_GATEWAY_CLI_LEGACY_ARGV_PROMPT -- When 1, the gateway passes the user message as a
# legacy argv prompt to claude. Default behavior uses stdin NDJSON
# (--input-format=stream-json) to match Claude Code. Only enable if you need old behavior
# for compatibility.
# VODOU_GATEWAY_CLI_LEGACY_ARGV_PROMPT=1

# VODOU_GATEWAY_DISABLE_PERSISTENT_CLI -- When 1, disables the persistent Claude CLI pool
# and uses one-shot CLI spawns per request (slower, colder starts, but simpler lifecycle).
# VODOU_GATEWAY_DISABLE_PERSISTENT_CLI=1

# VODOU_GATEWAY_LIST_TOOLS_LIVE -- When 1, the gateway executor may run vodou-core
# list-tools against live MCP connections for tool lists (slower, can block). When 0
# (default), prefer cached/registry-backed lists. Flip to 1 only when debugging tool
# registration.
# VODOU_GATEWAY_LIST_TOOLS_LIVE=0

# VODOU_GATEWAY_CLI_TURN_TIMEOUT_MS -- Wall-clock milliseconds allowed for one pooled CLI
# turn (one user message through tools). Default 900000 (15 minutes). Set 0 to disable the
# timeout (risky if a turn hangs).
# VODOU_GATEWAY_CLI_TURN_TIMEOUT_MS=900000

# VODOU_GATEWAY_CLI_POOL_IDLE_MS -- If no work is queued for a pooled CLI session this
# long, the gateway closes it to free RAM. Default 600000 (10 minutes).
# VODOU_GATEWAY_CLI_POOL_IDLE_MS=600000

# VODOU_CONVO_WINDOW_TURNS -- Sliding window of recent conversation turns the gateway
# replays in <conversation_history> on cold-spawn / non-warm-reuse paths. Default 20.
# Tune lower for tight context, higher for longer recall. Plan: PLAN-LONG-CONVO-RECALL.md.
# VODOU_CONVO_WINDOW_TURNS=20

# VODOU_CONVO_BOOTSTRAP_ONCE -- A.5 bootstrap-once optimization. When set to 0, disables
# the warm-reuse skip and falls back to the legacy behavior of re-feeding the full
# <conversation_history> block on every turn. Default ON (any value other than '0').
# Set to '0' if you suspect warm reuse is losing context. Plan: PLAN-LONG-CONVO-RECALL.md.
# VODOU_CONVO_BOOTSTRAP_ONCE=1

# CLAUDE_MODEL -- Default Anthropic model id string when using the API provider (e.g.
# claude-sonnet-4-20250514). Gateway DB settings may override. Must match a model your key
# can access.
# CLAUDE_MODEL=claude-sonnet-4-20250514

# OPENAI_MODEL -- Default OpenAI model id (e.g. gpt-4o) when OpenAI is the provider.
# OPENAI_MODEL=gpt-4o

# GOOGLE_MODEL -- Default Gemini model id when Google is the provider.
# GOOGLE_MODEL=gemini-2.0-flash

# GROQ_MODEL -- Default Groq model id when Groq is the provider.
# GROQ_MODEL=llama-3.1-70b-versatile

# DEEPSEEK_MODEL -- Default DeepSeek model id.
# DEEPSEEK_MODEL=deepseek-chat

# MISTRAL_MODEL -- Default Mistral model id.
# MISTRAL_MODEL=mistral-large-latest

# XAI_MODEL -- Default xAI Grok model id.
# XAI_MODEL=grok-beta

# OLLAMA_BASE_URL -- Base URL of your local Ollama server, usually http://localhost:11434.
# The gateway uses this when Ollama is the provider.
# OLLAMA_BASE_URL=http://localhost:11434

# OLLAMA_MODEL -- Model name as Ollama shows it (e.g. llama3.2) when Ollama is the
# provider.
# OLLAMA_MODEL=llama3.2

# VODOU_CHANNEL_ATTACHMENTS_DIR -- Override directory where Vodou-channels stores files
# downloaded from Slack/Telegram/Discord for vision/PDF. Default is
# <VODOU_PROJECT_PATH>/.vodou/channel-attachments. Use an absolute path if you want media on
# another disk.
# VODOU_CHANNEL_ATTACHMENTS_DIR=

# WHATSAPP_AUTH_DIR -- Directory for WhatsApp session data (Pairing/QR auth) used by
# Vodou-channels. Default <VODOU_PROJECT_PATH>/.vodou/whatsapp-auth. Must be persistent
# across restarts or you re-pair often.
# WHATSAPP_AUTH_DIR=

# CHANNEL_MEDIA_STRICT -- When 1, the gateway rejects attachment paths that are not under
# allowed roots (CHANNEL_MEDIA_ROOTS / defaults). Stronger security against path tricks;
# may block legitimate paths if misconfigured.
# CHANNEL_MEDIA_STRICT=1

# CHANNEL_MEDIA_ROOTS -- Comma-separated list of absolute path prefixes the gateway may
# read for channel images/documents. Example: your project .vodou folder and /tmp.
# Anything outside these prefixes can be denied when strict mode is on.
# CHANNEL_MEDIA_ROOTS="/absolute/path/to/project/.oi,/private/tmp,/tmp"

# CHANNEL_VISION_MAX_BYTES -- Maximum size in bytes for an image (or vision payload) the
# gateway will accept from a channel. Prevents huge uploads from exhausting RAM.
# CHANNEL_VISION_MAX_BYTES=5242880

# CHANNEL_DOCUMENT_MAX_BYTES -- Maximum size in bytes for PDF or document attachments the
# gateway will process.
# CHANNEL_DOCUMENT_MAX_BYTES=15728640

# CHANNEL_TEXT_ATTACHMENT_MAX_BYTES -- Maximum size in bytes for plain-text attachments.
# CHANNEL_TEXT_ATTACHMENT_MAX_BYTES=1048576

# CHANNEL_VISION_COMPAT_ENDPOINTS -- Comma-separated list of provider names that should
# receive vision in a "compatible" bundled form (routing hint for multimodal). Usually
# leave empty unless support asked you to set it.
# CHANNEL_VISION_COMPAT_ENDPOINTS=

# CHANNEL_OLLAMA_VISION -- When 1 or true, allows a code path that sends images to Ollama
# vision-capable models. Requires Ollama and a vision model; off by default.
# CHANNEL_OLLAMA_VISION=0

# ORT_DYLIB_PATH -- Filesystem path to the ONNX Runtime shared library (the bundled
# onnxruntime/lib/libonnxruntime.dylib on macOS, .so on Linux). REQUIRED for semantic
# (vector) memory — when set, memory computes embeddings for hybrid search. When UNSET,
# the whole memory layer silently falls back to keyword/FTS-only. The release ships the
# matching dylib (ONNX Runtime 1.23 = ort API 23), so this is ON by default. The installer
# rewrites it to an absolute path. Comment it out only if your platform can't load ONNX.
ORT_DYLIB_PATH=onnxruntime/lib/libonnxruntime.dylib

# VODOU_MEMORY_W_VECTOR -- Weight (0–1) for vector similarity in hybrid memory retrieval.
# Higher = "meaning" matters more. All weights (vector + FTS + recency + category) are
# normalized in code to sum to 1 for scoring.
VODOU_MEMORY_W_VECTOR=0.60

# VODOU_MEMORY_W_FTS -- Weight for full-text search match quality. Higher = keyword
# overlap matters more in retrieved memories.
VODOU_MEMORY_W_FTS=0.25

# VODOU_MEMORY_W_RECENCY -- Weight for recency (newer chunks score higher). Increase if
# you want fresher context; decrease if old but semantically relevant memories should
# compete equally.
VODOU_MEMORY_W_RECENCY=0.10

# VODOU_MEMORY_W_CATEGORY -- Weight for category alignment between query and stored memory
# metadata.
VODOU_MEMORY_W_CATEGORY=0.05

# VODOU_MEMORY_W_TRUST -- Provenance demotion strength (PLAN-UNIVERSAL-MEMORY-V2 F1).
# Imported history (import:% scopes) scores x(1-w), live-capture lanes (capture:%)
# x(1-w/2); first-party chunks (web/gateway/channel/workbench) are untouched. Soft
# multiplier, never a filter -- a highly-relevant import still beats irrelevant
# first-party memory. 0 disables demotion entirely.
VODOU_MEMORY_W_TRUST=0.15

# VODOU_MEMORY_W_DUP -- Fact-group demotion strength (Universal Memory V2 Phase B).
# Chunks that lost near-duplicate canonical election (mem dedup scan) or a
# contradiction resolution score x(1-w) so the canonical copy owns the top-k slot.
# Demotion, never deletion -- reverse any group with `mem dedup clear`. 0 disables.
VODOU_MEMORY_W_DUP=0.60

# VODOU_MEMORY_ENTITY_EXPANSION -- Entity alias expansion at retrieval (Universal
# Memory V2 Phase B #4). Queries mentioning one alias of a known entity ("abraham")
# also retrieve chunks that use another spelling ("Jim Abraham") -- appended to the
# FTS leg only. Populate entities with `mem entities scan`. 0 disables.
VODOU_MEMORY_ENTITY_EXPANSION=1

# VODOU_CAPTURE_IDE_ENABLED -- Passive IDE session capture (Universal Memory V2
# Phase C). When 1, the daemon periodically pulls new Cursor / Claude Code
# session turns off local disk into capture:ide:<app> memory (the gateway
# extractor then distils them). OFF by default -- IDE sessions contain your
# code and prompts. Companion knobs:
#   VODOU_CAPTURE_IDE_SOURCES      cursor | claude-code | all   (default cursor)
#   VODOU_CAPTURE_IDE_INTERVAL_SECS  poll interval, min 60      (default 900)
#   VODOU_CAPTURE_IDE_SINCE_HOURS    claude-code recent window  (default 48)
# VODOU_CAPTURE_IDE_ENABLED=0

# VODOU_BYOK_SCOPED_IDS -- BYOK capture identity (Universal Memory V2 Phase C W1b).
# When on (default), conversations arriving through the OpenAI-compatible /v1
# endpoint from an external app (Cursor, Continue, Aider, custom scripts naming
# themselves via the X-Vodou-App header) get `byok:<app>:` conversation ids, so
# their extracted memory is scoped `capture:byok:<app>` (capture trust tier,
# never auto-promoted). 0 reverts to bare-UUID web-scoped extraction.
VODOU_BYOK_SCOPED_IDS=1

# VODOU_MEMORY_TOP_K -- How many memory chunks to retrieve per search before ranking.
# Higher = broader recall but more noise and cost to send to the model.
VODOU_MEMORY_TOP_K=5

# VODOU_MEMORY_W_HEARTBEAT -- Multiplier applied to heartbeat-generated memories so they
# do not drown out user-authored memories in search (typical default scale 0.0–1.0 style
# behavior—see code for exact math).
# VODOU_MEMORY_W_HEARTBEAT=0.3

# VODOU_MEMORY_RERANK_K -- How many top hybrid-search candidates the BGE cross-encoder
# reranker scores (after RRF). Larger = better reordering but more CPU time. Typical
# 10–30.
# VODOU_MEMORY_RERANK_K=10

# VODOU_MEMORY_RERANK_SKIP_COSINE -- If the best raw vector cosine for the top RRF hit is
# ≥ this threshold (0.0–1.0, default 0.75), skip reranking—saves ~1s when the winner is
# already obvious. Set 0 to always rerank (slower).
# VODOU_MEMORY_RERANK_SKIP_COSINE=0.75

# VODOU_MEMORY_COSINE_FLOOR -- Override injection floor (default is model-aware:
# MiniLM 0.30, bge-small 0.40 via memory_floor_defaults). Leave unset unless tuning.
# VODOU_MEMORY_COSINE_FLOOR=0.30

# VODOU_MEMORY_VECTOR_CACHE -- In-daemon RAM cache of chunk + question-key embedding
# pools (default 1 = on). Removes ~500-700ms/search of SQLite blob streaming; the
# cache only RANKS — winners are re-fetched with eligibility re-applied, so results
# are never stale. Set 0 to fall back to the streaming scan.
# VODOU_MEMORY_VECTOR_CACHE=1

# VODOU_MEMORY_VECTOR_CACHE_MAX_MB -- Size guard for the vector cache (default 768).
# A store whose embedding pools exceed the cap logs once and streams as before —
# degrades to pre-cache behavior instead of growing daemon RAM unbounded.
# VODOU_MEMORY_VECTOR_CACHE_MAX_MB=768

# VODOU_MEMORY_EMBED_MODEL -- Memory-slot embedder ONLY (intent/skill stay MiniLM).
# Leave UNSET for release defaults:
#   - fresh/empty vault → bge-small (bundled in DMG/prebuilt)
#   - existing MiniLM vault → stay MiniLM until System → Memory brain upgrade
#   - after upgrade, persisted in vodou-core.db metadata.memory_embed_model
# Env wins over metadata when set. Explicit values: bge-small | minilm | gemma-300m
# VODOU_MEMORY_EMBED_MODEL=bge-small

# VODOU_DEDUP_ENABLED -- Weekly near-dup scan (default ON). Set 0 to disable.
# VODOU_DEDUP_ENABLED=1
# VODOU_DEDUP_INTERVAL_HOURS=168
# VODOU_DEDUP_MAX_CHUNKS=100000

# VODOU_SELFTEST_ENABLED -- Nightly memory health self-heal (default ON; skips
# cleanly when no LLM provider / heuristic). Set 0 to disable.
# VODOU_SELFTEST_ENABLED=1
# VODOU_SELFTEST_INTERVAL_HOURS=24
# VODOU_SELFTEST_MAX_LLM_CALLS=12

# VODOU_MEMORY_EMBED_CPU -- When 1, force CPU path for query/chunk embeddings (disables
# GPU/CoreML fast path in the embedder). For debugging or comparing throughput only.
# VODOU_MEMORY_EMBED_CPU=0

# VODOU_MEMORY_RERANK_CPU -- When 1, force CPU for the reranker model. For debugging or
# when GPU/CoreML misbehaves.
# VODOU_MEMORY_RERANK_CPU=0

# VODOU_MEMORY_EXTRACTION_PROVIDER -- Which backend categorizes / extracts memories into
# memory.db (e.g. auto uses your current gateway provider, or anthropic, openai, ollama,
# claude, script). Wrong value can break extraction silently—auto is safest if the gateway
# is configured.
# VODOU_MEMORY_EXTRACTION_PROVIDER=auto

# VODOU_EXTRACTION_TIMEOUT_SECS -- Seconds to wait for an extraction LLM call before
# failing the extraction attempt. Raise on slow networks; lower to fail fast.
# VODOU_EXTRACTION_TIMEOUT_SECS=60

# VODOU_ENABLE_MEMORY_COMPACT_SCHEDULE -- LEGACY. When 1, seeds a scheduled `mem compact`
# of MEMORY.md. Since PLAN-DYNAMIC-MEMORY-MD (2026-08-16) MEMORY.md is RENDERED from
# memory.db and the file is a daemon-written snapshot, so there is nothing to compact —
# leave this 0 (default). Setting 1 re-seeds the task on every startup.
VODOU_ENABLE_MEMORY_COMPACT_SCHEDULE=0

# VODOU_MEMORY_COMPACT_SCHEDULE -- Human-readable schedule for compaction, e.g. every 1d.
# Parsed by the in-process scheduler—see vodou-core docs for supported phrases.
VODOU_MEMORY_COMPACT_SCHEDULE="every 1d"

# VODOU_MEMORY_COMPACT_MAX -- Safety cap: maximum number of lines or units processed per
# compaction run so one run cannot freeze the machine on a huge file.
VODOU_MEMORY_COMPACT_MAX=120

# VODOU_MEMORY_RENDER_BUDGET -- Byte cap for the RENDERED MEMORY.md (PLAN-DYNAMIC-MEMORY-MD).
# MEMORY.md is built from memory.db at every session start: pinned facts first, then the
# session's project memories, then global. It shares the 24 KB startup bootstrap budget with
# AGENTS.md and the other workspace files, so this is a ceiling (1000-20000; default 6000).
# VODOU_MEMORY_RENDER_BULLETS caps the bullet count (5-200; default 48).
# VODOU_MEMORY_RENDER_BUDGET=6000
# VODOU_MEMORY_RENDER_BULLETS=48

# VODOU_JANITOR_ENABLED -- When 1, the worker runs the memory janitor on a cron:
# deduplicates similar chunks, rewrites fuzzy dates to absolute ones, and prunes obsolete
# tagged content. Long-term memory is preserved by design; heavy deletion only triggers in
# edge cases (e.g. over chunk cap).
VODOU_JANITOR_ENABLED=1

# VODOU_JANITOR_SCHEDULE -- Cron expression for janitor runs (default 0 2 * * * = 02:00
# daily). Uses the worker's clock.
VODOU_JANITOR_SCHEDULE="0 2 * * *"

# VODOU_SKILL_PROPOSER_ENABLED -- When 1, the worker runs the skill-learning loop's
# proposer on a cron (PLAN-SKILL-LEARNING-LOOP). It mines recurring, successful,
# user-accepted tool-chains captured during chat and writes INERT draft skills
# (is_active=0, no routing) awaiting `vodou-core skill verify` + `skill promote`.
# Safe unattended: drafts never route until promoted; runs in-process (no subprocess);
# currently zero API cost (deterministic synthesis + local embeddings). Provider-agnostic.
VODOU_SKILL_PROPOSER_ENABLED=1

# VODOU_SKILL_PROPOSER_SCHEDULE -- Cron for the proposer (default 0 3 * * * = 03:00 daily).
# The skill-worthy gate (>=4 steps, recurrence >=2, accepted/refined) means it only
# proposes genuinely repeated workflows, so a daily cadence is plenty.
VODOU_SKILL_PROPOSER_SCHEDULE="0 3 * * *"

# VODOU_SKILL_OPTIMIZER_ENABLED -- When 1, the worker runs Phase-3 routing
# self-optimization on a cron: re-weights AUTONOMOUS skill trigger priorities
# (<80) from real signal_log auto-route outcomes — boosts skills that succeed
# (toward 60), decays those that fail (toward 20). Never touches user-curated
# (>=80) routes. EWMA-smoothed; needs >=3 decided routes per skill before moving.
# Safe unattended: only adjusts already-promoted autonomous routes within [20,60].
VODOU_SKILL_OPTIMIZER_ENABLED=1

# VODOU_SKILL_OPTIMIZER_SCHEDULE -- Cron for the optimizer (default weekly, Sun 4am).
# Weekly because routing stats need time to accumulate before a re-weight is meaningful.
VODOU_SKILL_OPTIMIZER_SCHEDULE="0 4 * * 7"

# VODOU_SKILL_AUTO_PROMOTE -- When 1, the worker runs an UNATTENDED verify+promote
# sweep over autonomous DRAFTS on a cron (A5). Default OFF — the standard posture is
# human `skill promote` (the governance differentiator). When on, it promotes ONLY
# drafts that pass the same deterministic verify gate a human promote requires, and
# audits them as actor=auto-promote. Turn on for hands-off operation.
# VODOU_SKILL_AUTO_PROMOTE=1
# VODOU_SKILL_AUTO_PROMOTE_SCHEDULE -- Cron (default "30 3 * * *" = 03:30 daily, just
# after the 3am proposer, so a draft proposed overnight is promoted the same night).
# VODOU_SKILL_AUTO_PROMOTE_SCHEDULE="30 3 * * *"

# VODOU_SKILL_VERIFY_LIVE -- When 1, `skill verify` additionally EXECUTES the clearly
# read-only steps of a skill (one-shot per step) to catch runtime breakage the static
# checks miss; mutating/templated steps are never run. Default OFF — it needs live
# creds/network and makes verify side-effecting + slower. Opt-in for a deeper gate.
# VODOU_SKILL_VERIFY_LIVE=1

# VODOU_SKILL_CURRICULUM_ENABLED -- When 1, the worker runs the Phase-4 curriculum
# miner on a cron: it mines recurring FAILURE signals (failed/abandoned/corrected
# trajectories + timed-out/errored routes) into capability gaps and queues drafted
# practice tasks. It does NOT run them — they sit PENDING. Default OFF.
# VODOU_SKILL_CURRICULUM_ENABLED=1
# VODOU_SKILL_CURRICULUM_SCHEDULE -- Cron (default weekly, Sun 5am).
# VODOU_SKILL_CURRICULUM_SCHEDULE="0 5 * * 7"

# VODOU_SKILL_CURRICULUM_AUTORUN -- When 1 (AND _ENABLED is on), pending practice
# tasks actually EXECUTE through the gateway (captured → round-trip the learning
# loop). This is the only curriculum switch that spends tokens / self-initiates
# action. Default OFF. Rate-capped by VODOU_SKILL_CURRICULUM_MAX (default 2/run).
# Curriculum-born drafts are NEVER auto-promoted — they always require human promote.
# VODOU_SKILL_CURRICULUM_AUTORUN=1
# VODOU_SKILL_CURRICULUM_MAX=2

# VODOU_SKILL_ADVISORY -- When 1, the daemon surfaces a non-executing "### Suggested Skill"
# hint when a prompt keyword-routes to NOTHING but semantically matches a promoted skill.
# It only suggests (the agent may load via vc_load_skill); it never auto-runs, and it is
# suppressed whenever an intent/tool route already fired (no double-suggest). Default OFF.
VODOU_SKILL_ADVISORY=1

# VODOU_SKILL_ADVISORY_THRESHOLD -- Cosine floor for the advisory (default 0.6). Genuine
# keyword-free paraphrases of a skill land ~0.4-0.45; raise toward 0.5-0.6 to reduce noise.
VODOU_SKILL_ADVISORY_THRESHOLD=0.40

# VODOU_MEMORY_CHUNK_CAP -- Emergency ceiling on total memory chunks. A late janitor phase
# only engages when count exceeds this—not everyday pruning. Default is very high (~years
# of use); tune only if you understand runaway protection.
VODOU_MEMORY_CHUNK_CAP=500000

# VODOU_JANITOR_DRY_RUN -- When 1, the janitor never writes to the database—reports only.
# Useful for auditing what it would do. Some CLI invocations also respect first-run
# dry-run windows.
# VODOU_JANITOR_DRY_RUN=0

# VODOU_INTENT_SIGNAL_ENABLED -- Master switch for the intent signal layer in the daemon:
# on each prompt, it can match keywords to intent_mappings and optionally invoke tools.
# Set 0 to disable the whole layer (hooks become memory-only for that path).
VODOU_INTENT_SIGNAL_ENABLED=1

# VODOU_INTENT_AUTO_ROUTE -- When 0, the daemon still computes intent signals and logs
# telemetry but does not call the worker/brain to inject live tool output—useful to
# observe matches without auto-execution.
VODOU_INTENT_AUTO_ROUTE=1

# VODOU_INTENT_SIGNAL_TIMEOUT_MS -- Hard timeout in milliseconds for the worker brain call
# used during auto-routing (cold path can include spawning work). Prevents the hook from
# blocking your editor forever.
VODOU_INTENT_SIGNAL_TIMEOUT_MS=5000

# VODOU_FLUSH_EVERY_N_PROMPTS -- After this many assistant replies in gateway chat,
# trigger a memory flush (extraction pipeline). Default 15. Lower = more frequent writes
# to memory; higher = fewer, larger batches.
# VODOU_FLUSH_EVERY_N_PROMPTS=15

# VODOU_AUTONOMOUS_PLAN_PATH -- Path (often under .vodou/workspace/) to the autonomous
# plan markdown file the scheduler's planning step reads or updates.
# VODOU_AUTONOMOUS_PLAN_PATH=.vodou/workspace/autonomous-plan.md

# VODOU_SCHEDULER_USE_PLANNING -- When enabled, scheduler runs include an autonomous
# planning phase (ties into plan files and extraction provider). Disable for minimal
# scheduler behavior.
# VODOU_SCHEDULER_USE_PLANNING=1

# VODOU_SCHEDULER_MAX_RUNS_PER_DAY -- Hard cap on how many scheduler-triggered brain runs
# may execute per calendar day—prevents runaway loops or API spend.
# VODOU_SCHEDULER_MAX_RUNS_PER_DAY=1000

# VODOU_SCHEDULER_TASK_TIMEOUT_SECS -- Kill a scheduled task subprocess after this many
# seconds if it has not finished (stuck tool, network hang, etc.).
# VODOU_SCHEDULER_TASK_TIMEOUT_SECS=300

# VODOU_SELF_IMPROVE_PLAN_PATH -- Alternate markdown path for self-improvement planning
# content; planning code may fall back between this and VODOU_AUTONOMOUS_PLAN_PATH.
# VODOU_SELF_IMPROVE_PLAN_PATH=

# VODOU_WORKER_SCHEDULER_INTERVAL_SECS -- How often the worker wakes up to check due
# scheduled tasks (seconds). Minimum enforced in code (do not set absurdly low on large
# installs).
# VODOU_WORKER_SCHEDULER_INTERVAL_SECS=60

# VODOU_WORKER_SCHEDULER -- Set to 0 or false to disable the worker's periodic scheduler
# loop entirely (no due-task execution from DB). Heartbeat/janitor hooks inside the worker
# may still behave differently—restart after change.
# VODOU_WORKER_SCHEDULER=1

# VODOU_HEARTBEAT_ENABLED -- When 1, the scheduler triggers periodic heartbeat calls to
# your gateway: a background "think about the project" loop that can use deep thinking and
# tools. Disable if you want zero autonomous background LLM use.
VODOU_HEARTBEAT_ENABLED=1

# VODOU_HEARTBEAT_INTERVAL -- Time between heartbeats, e.g. 1h, 30m. Parsed as a duration
# string by the scheduler.
VODOU_HEARTBEAT_INTERVAL=1h

# VODOU_HEARTBEAT_MAX_TOKENS -- Token budget for the LLM portion of one heartbeat (higher
# if deep thinking needs long context).
# VODOU_HEARTBEAT_MAX_TOKENS=16384

# VODOU_HEARTBEAT_MAX_TOOL_ROUNDS -- Maximum tool-use rounds per heartbeat (each round can
# be multiple tools). Prevents infinite tool loops.
# VODOU_HEARTBEAT_MAX_TOOL_ROUNDS=20

# VODOU_HEARTBEAT_TIER -- Capability level: 0 = read-only + suggestions; 1 = may create
# tasks; 2 = may execute more autonomous actions. Higher tiers increase risk—keep at 0
# unless you trust the loop.
# VODOU_HEARTBEAT_TIER=0

# VODOU_HEARTBEAT_ACTIVE_HOURS -- Local-time window when heartbeats may run, e.g.
# 08:00-22:00. Empty = always allowed (subject to other limits).
# VODOU_HEARTBEAT_ACTIVE_HOURS=08:00-22:00

# VODOU_HEARTBEAT_SUPPRESS_OK -- When 1, HEARTBEAT_OK status lines are not forwarded to
# external channels (Slack/Discord/etc.) so channels stay quiet.
# VODOU_HEARTBEAT_SUPPRESS_OK=1

# VODOU_HEARTBEAT_INJECT_LEDGER -- When 1, the heartbeat prompt includes your currently
# open tasks so the LLM updates them instead of regenerating duplicates each run. Default
# off. Requires daemon restart to toggle — value is cached at first scheduler tick.
# VODOU_HEARTBEAT_INJECT_LEDGER=0

# VODOU_HEARTBEAT_AUTO_CLOSE_GREP -- When 1, each heartbeat checks git log (last 30 days)
# for commits whose messages match open task keywords. Candidates are surfaced in the
# prompt for LLM confirmation — the LLM marks them done with - [x] if the evidence is
# convincing. HEAD-change gate: the grep only runs when new commits exist since the last
# run (no-op if nothing changed). Default off. Requires daemon restart to toggle.
# VODOU_HEARTBEAT_AUTO_CLOSE_GREP=0

# VODOU_HEARTBEAT_MAX_PER_HOUR -- Rate limit: maximum heartbeat invocations per hour to
# protect API quota.
# VODOU_HEARTBEAT_MAX_PER_HOUR=10

# VODOU_HEARTBEAT_MAX_FAILURES -- After this many consecutive failures talking to the
# gateway, heartbeat auto-disables until you fix URL/auth and re-enable.
# VODOU_HEARTBEAT_MAX_FAILURES=5

# VODOU_GATEWAY_URL -- Full base URL the scheduler/worker uses to call gateway HTTP APIs
# for heartbeat (e.g. http://localhost:8765). Must match where the gateway actually
# listens (scheme, host, port).
VODOU_GATEWAY_URL=http://localhost:8765

# VODOU_GATEWAY_SCHEDULER_SECRET -- Shared secret the worker sends (e.g. on heartbeat
# routes) so random clients cannot trigger privileged endpoints. Must match what the
# gateway expects. Empty = some routes may be open—set in production or on exposed
# networks. Same header (X-Scheduler-Secret) protects POST /chat/skill-fire.
# VODOU_GATEWAY_SCHEDULER_SECRET=

# VODOU_GATEWAY_DB_PATH -- Optional. vodou-core MCP tool vc_skills_create opens this
# gateway.db for skills_meta / skill_console_bindings inserts. Default: MCP-servers/
# Vodou-Console/gateway.db under the project. Tests and multi-root layouts only; if
# you set it, point GATEWAY_DB_PATH (Node gateway) at the same file.
# VODOU_GATEWAY_DB_PATH=

# VODOU_SKILLS_SOFT_CAP -- Max active Skill Console rows (skills_meta is_active=1)
# before vc_skills_create rejects (default 20). Legacy: VODOU_SKILL_CONSOLE_MAX_ACTIVE.
# VODOU_SKILLS_SOFT_CAP=20

# =============================================================================
# OPTIONAL -- gateway / MCP (not required for basic chat)
# =============================================================================

# VODOU_DB_HEALTH_INTERVAL_MS -- gateway.db `PRAGMA quick_check` cadence in the gateway
# (default 600000 = 10 min; 0 disables). Each tick logs freelist/page counts so a
# corruption can be dated afterwards. See PLAN-GATEWAY-DB-REPAIR (0.6.26).
# VODOU_DB_INTEGRITY_INTERVAL_MS -- FULL `PRAGMA integrity_check` + FTS5 integrity-check
# cadence (default 21600000 = 6 h; 0 disables); also runs 60 s after boot. Catches a wrong
# freelist -- the seed of every gateway.db corruption so far -- before it cross-links a
# table. On failure the log points at scripts/repair-gateway-db.sh. The daemon also keeps
# a daily hot copy at backups/gateway-db-daily/ (newest 7).
# VODOU_DB_HEALTH_INTERVAL_MS=600000
# VODOU_DB_INTEGRITY_INTERVAL_MS=21600000

# OAUTH_DCR_CLIENT_NAME -- Name shown on third-party OAuth consent screens when vodou-core
# registers via Dynamic Client Registration (Apps hub, oauth-begin). Default: Vodou.
# Override for white-label builds.
# OAUTH_DCR_CLIENT_NAME=Vodou

# OAUTH_DCR_CLIENT_URI -- Website / policy URL shown next to that name during OAuth
# consent. Default: https://vodou.ai. Set empty to omit client_uri in the DCR payload
# (only if the provider allows it).
# OAUTH_DCR_CLIENT_URI=https://vodou.ai

# VODOU_OPENAI_COMPAT_TOKEN -- If set, HTTP requests to the gateway's OpenAI-compatible
# /v1 endpoints must send Authorization: Bearer <this>. If empty, those endpoints may be
# unauthenticated—dangerous on public networks.
# VODOU_OPENAI_COMPAT_TOKEN=

# VODOU_MCP_HEALTH_INTERVAL_MS -- Milliseconds between background MCP health checks in the
# gateway (default several minutes). Shorter = fresher status, more overhead.
# VODOU_MCP_HEALTH_INTERVAL_MS=300000

# VODOU_WORKER_SOCK_FIRST_BYTE_MS -- Timeout waiting for the first byte from the worker
# Unix socket when the gateway forwards a tool call—raise if the worker is cold and slow.
# VODOU_WORKER_SOCK_FIRST_BYTE_MS=5000

# STACKOVERFLOW_API_KEY -- API key for Stack Overflow's API when using the
# stackoverflow-mcp integration—improves rate limits versus anonymous access.
# STACKOVERFLOW_API_KEY=

# MCP_REGISTRY_DASHBOARD_ALLOW_RUN -- For the mcp-registry local dashboard (127.0.0.1
# only): when 1, allows POST /api/run from the UI. Off by default—prevents accidental
# command execution.
# MCP_REGISTRY_DASHBOARD_ALLOW_RUN=0

# MCP_REGISTRY_VC_WRITE -- When 1, allows the MCP registry toolkit to write Vodou DB rows
# (e.g. oauth-begin probes). Legacy alias MCP_REGISTRY_BT4_WRITE may still be read for one
# release. Keep 0 unless you are actively using registry VC flows.
# MCP_REGISTRY_VC_WRITE=0

# =============================================================================
# KANBAN BOARD -- multi-agent durable Kanban (see docs/kanban-board.md)
# =============================================================================

# VODOU_BOARD_REAL_SPAWN -- When 1, the embedded dispatcher actually shells
# `claude -p` for each claimed task (autonomous execution). When 0 / unset,
# the dispatcher still claims tasks and emits `spawn_skipped` events but no
# worker is launched (dry-run mode, default for safety on fresh installs).
# Flip to 1 once you've created your first task and want it to auto-run.
VODOU_BOARD_REAL_SPAWN=1

# VODOU_BOARD_BACKEND -- Worker execution backend for board task dispatch.
#   auto      (default) — uses claude-cli if found on PATH or via CLAUDE_BIN;
#             falls back to gateway automatically on fresh installs where claude
#             lives in ~/.local/bin (common on Linux VMs / launchd envs).
#   gateway   — always route task execution through the gateway's configured LLM.
#             Works with any of the 15 supported providers (Anthropic API, Fireworks,
#             OpenAI, Groq, Kimi, etc.). No Claude CLI required.
#   claude-cli — always spawn a local claude -p process (requires Claude CLI on PATH
#             or CLAUDE_BIN set to its absolute path).
# Recommended for BYOK users or VMs where claude isn't on the daemon PATH:
VODOU_BOARD_BACKEND=auto

# VODOU_BOARD_TOOLS_ALWAYS_ON -- When 1, the board_* tools are exposed to NORMAL
# chat (visible in tools/list + callable), like any other always-on Vodou MCP
# server. When 0 / unset (default), the board is worker-only: tools are hidden
# from chat and only appear inside a dispatcher-spawned worker (VODOU_BOARD_TASK
# set). Exposure ≠ task context — the 6 task-scoped tools (board_show / complete /
# block / heartbeat / artifact / request_approval) still require an explicit
# `task_id` arg when there's no worker task. Do NOT instead set VODOU_BOARD_TASK to
# a placeholder to "open the gate": that points those tools at a bogus task id.
# VODOU_BOARD_TOOLS_ALWAYS_ON=1

# CLAUDE_BIN -- Absolute path to the Claude CLI binary. Only needed when claude
# is installed in a non-standard location (e.g. ~/.local/bin/claude) that the
# daemon's PATH doesn't include. Takes precedence over PATH search and common
# location probing. Leave unset if `which claude` works in your shell.
# CLAUDE_BIN=/Users/you/.local/bin/claude

# VODOU_BOARD_DISPATCH_INTERVAL_MS -- Embedded dispatcher tick interval in
# the gateway. Default 30000 (30s). Lower = more responsive, more sqlite
# pressure; higher = sleepier boards.
# VODOU_BOARD_DISPATCH_INTERVAL_MS=30000

# VODOU_BOARD_NOTIFIER_INTERVAL_MS -- Embedded notifier tick interval (polls
# task_events, fires per-platform notifications). Default 5000 (5s).
# VODOU_BOARD_NOTIFIER_INTERVAL_MS=5000

# VODOU_BOARD_DISPATCH_TIMEOUT_MS -- SIGKILL budget for each gateway-driven
# `board dispatch` shell-out. Default 60000 (60s). Must comfortably exceed a
# single tick's worst case (claim + context build + spawn); too low SIGKILLs the
# dispatcher mid-tick and leaves tasks claimed-but-unspawned.
# VODOU_BOARD_DISPATCH_TIMEOUT_MS=60000

# VODOU_BOARD_GATEWAY_ACK_TIMEOUT -- Seconds the dispatcher waits for the gateway
# to ACK a board task (gateway backend). The gateway replies 202 immediately and
# runs the task in the background, so this only covers the accept. Default 30.
# VODOU_BOARD_GATEWAY_ACK_TIMEOUT=30

# VODOU_WORKER_WARMUP -- Set to 0 to disable the BrainLoader warmup the worker runs
# at boot (warmup makes the first chat/board call fast instead of cold ~30-70s).
# On by default. Only disable if warmup misbehaves on a constrained box.
# VODOU_WORKER_WARMUP=0

# VODOU_BOARD_DISPATCH_DISABLED -- When 1, disables the embedded dispatcher
# loop entirely. Use during dev / debug when you want to drive ticks
# manually via `./do board dispatch`. Notifier has its own _DISABLED flag.
# VODOU_BOARD_DISPATCH_DISABLED=0
# VODOU_BOARD_NOTIFIER_DISABLED=0

# VODOU_BOARD_REQUIRE_JWT -- When 1, REST writes to /api/board/* require an
# HS256-signed token (key auto-generated in vodou-core.db). The dispatcher
# auto-mints tokens for spawned workers via VODOU_BOARD_WRITE_TOKEN env.
# Off by default for dev; flip to 1 in production / multi-user setups.
# VODOU_BOARD_REQUIRE_JWT=0

# DISCORD_PUBLIC_KEY -- 32-byte hex public key from your Discord Developer
# Portal app, used by /api/board/channel-action to verify Ed25519 signatures
# on Approve/Deny button presses. Unset = accept-all (dev mode, insecure).
# DISCORD_PUBLIC_KEY=

# SLACK_SIGNING_SECRET -- HMAC secret from your Slack app's "Basic
# Information" page, used to verify x-slack-signature headers on the same
# /api/board/channel-action receiver. Unset = accept-all (dev mode).
# SLACK_SIGNING_SECRET=

# =============================================================================
# TROUBLESHOOTING -- off by default, flip on to debug
# =============================================================================

# DEBUG -- Any non-empty value turns on verbose diagnostics in parts of the gateway (e.g.
# executor logging). Very noisy—use briefly while troubleshooting.
# DEBUG=1

# VODOU_RECALL_TRACE -- If set to any value, continuity::recall logs one [continuity
# recall] line per search (principal, scope, mode, timing). Unset = off. Use briefly when
# debugging memory recall / Phase 2 plumbing.
# VODOU_RECALL_TRACE=1

# VODOU_SHOW_RAW_RESULTS -- When 1, gateway chat shows raw <oi_results> tool blocks
# instead of stripping them for a cleaner UI. The gateway re-reads this from .env on some
# paths without a full restart.
# VODOU_SHOW_RAW_RESULTS=1

# VODOU_LOG_MAX_MB -- When .vodou/system.log grows beyond this many megabytes, it is
# rotated/trimmed (keeps a tail). Prevents unbounded disk use.
# VODOU_LOG_MAX_MB=5

# VODOU_PROCESS_TIMEOUT_SECS -- Watchdog: seconds before vodou-core forcibly kills a stuck
# agent/tool child process. Raise for legitimately long tools; lower to recover faster
# from hangs.
# VODOU_PROCESS_TIMEOUT_SECS=60

# VODOU_DISABLE_OUTPUT_PATH_INJECTION -- When 1, disables automatic "output path" hints
# appended to some tool results (used so the model knows where files landed). Enable if
# those hints confuse your workflow.
# VODOU_DISABLE_OUTPUT_PATH_INJECTION=0

# VODOU_AGENT_ENABLED -- When 0 or false, disables the agent layer inside vodou-core
# (background agent behavior). Does not disable normal chat tools.
# VODOU_AGENT_ENABLED=true

# VODOU_MEMORY_ROOT -- Override the directory for workspace memory files (default
# .vodou/workspace). Use if you keep memory on another volume or a named workspace.
# VODOU_MEMORY_ROOT=

# ── Managed/API web-chat file tools (PLAN 0.6.4 §6) ──────────────────────────
# Give the API-provider web chat (Vodou managed LLM, DeepSeek, Qwen, Fireworks,
# etc.) sandboxed write_file/read_file/list_dir/edit_file tools, the way Claude
# Code has them. OFF by default. Tools are offered ONLY to real WEB chats (not
# channels/scheduler/board workers) and are confined to a per-conversation workspace.
#
# VODOU_FS_TOOLS_ENABLED -- 1/true to expose the FS tools (read_file/write_file/
# edit_file/multi_edit/list_dir/search_files/grep/glob/file_stat/directory_tree) to
# the main web chat. Set ON by default; the surface stays byte-identical when off.
VODOU_FS_TOOLS_ENABLED=1
#
# VODOU_FS_TOOLS_ROOT -- Base directory for per-conversation workspaces. Default
# <project>/.vodou/workspace/agent-files . Final path is <root>/<tenant>/<conversationId>/.
# VODOU_FS_TOOLS_ROOT=
#
# VODOU_FS_TOOLS_MAX_BYTES -- Per-operation byte cap for write/read/edit (default
# 2000000 = 2 MB). Oversized writes are refused; oversized reads are truncated.
# VODOU_FS_TOOLS_MAX_BYTES=2000000
#
# ── Sandbox confinement mode (default OFF = per-conversation workspace) ──
# VODOU_FS_TOOLS_FLAT_ROOT -- 1/true points the tools at VODOU_FS_TOOLS_ROOT
# DIRECTLY, with no <tenant>/<conversationId> nesting. Still fully confined to that
# root. Use to aim the tools at one fixed directory. Default off.
# VODOU_FS_TOOLS_FLAT_ROOT=0
#
# VODOU_FS_TOOLS_UNSANDBOXED -- 1/true turns OFF confinement: the tools may read/write
# ABSOLUTE paths anywhere (relatives resolve against VODOU_FS_TOOLS_ROOT or the project
# root). This is "Claude Code on your own machine." LOCAL/SINGLE-USER ONLY — it is
# hard-ignored the instant a real per-request tenant is supplied (multi-tenant/cloud),
# restoring full confinement. The sandbox IS the security boundary; with it off, set
# perm_profile=workspace (file_write -> ask) so the approval gate guards writes. The
# denylist (.env/.ssh/*.key/*.db/vodou-core) still applies (see next var).
# ⚠️ SET ON by default — a fresh install gives web chat WHOLE-MACHINE file access
# (minus the denylist). Set to 0 to keep tools confined to the per-conversation
# sandbox; or use VODOU_FS_TOOLS_FLAT_ROOT for a bounded single directory instead.
VODOU_FS_TOOLS_UNSANDBOXED=1
#
# VODOU_FS_TOOLS_UNSANDBOXED_ALLOW_PROTECTED -- 1/true ALSO lifts the denylist when
# unsandboxed (true no-guards dev box). Ignored unless UNSANDBOXED is on. Default off.
# VODOU_FS_TOOLS_UNSANDBOXED_ALLOW_PROTECTED=0
#
# VODOU_FS_BASH_ENABLED -- Reserved for the later `bash` tool phase (NOT implemented
# yet — needs @anthropic-ai/sandbox-runtime + an approval gate). Keep off.
# VODOU_FS_BASH_ENABLED=0

# ── Gateway Projects (multi-workspace) — PLAN-GATEWAY-PROJECTS, see docs/gateway-projects.md ──
# A "project" points the gateway at a working directory: its chats, file root, and
# instructions are scoped to it while the brain (servers, creds, daemon, memory) stays
# shared. These two vars are operational knobs; the feature works without setting either.
#
# VODOU_PROJECT_SPAWN_SETTLE_MS -- When a turn runs in a NON-Default project, the gateway
# spawns the claude-cli subprocess with cwd = that project's directory. Two such spawns
# starting at the exact same instant can trip a claude-cli startup race (it may resolve a
# relative write against the install root instead of the project dir). The gateway
# serializes fresh non-Default project spawns and holds the slot for this many ms so the
# next one starts only after the previous claude-cli is past its racy init. Default 1200.
# Lower = snappier concurrent multi-project turns but reopens the race window; 0 disables
# the settle (serialization still applies). Only affects simultaneous DIFFERENT-project turns.
# VODOU_PROJECT_SPAWN_SETTLE_MS=1200
#
# VODOU_PROJ_CWD_DIAG -- 1/true emits [proj-cwd DIAG] lines on every claude-cli session
# spawn (the per-project cwd it computed, warm-pool adoption decisions). Off by default;
# turn on only when debugging per-project file-routing. Verbose (one line per spawn).
# VODOU_PROJ_CWD_DIAG=0

# VODOU_TOOLCALL_RECOVERY -- Tool-call robustness for OpenAI-compatible providers
# (#8 §1.5). ON by default. When a provider emits a tool call as TEXT (DeepSeek
# ~11%, self-hosted Qwen/vLLM <tool_call> XML leaks) instead of a structured
# tool_calls array, the gateway recovers it — but only a call naming a tool that
# was actually offered (no-op on normal prose, and on well-behaved providers like
# the managed kimi tier). Also repairs malformed tool-call arguments. Set to 0 to
# disable and fall back to strict structured-only parsing.
# VODOU_TOOLCALL_RECOVERY=1

# VODOU_NO_TOOLS_MODELS -- Comma/space-separated model-id SUBSTRINGS for which the
# gateway should NOT offer tools (#8 §1.5b). Use if a particular model mishandles
# tool calling — it then runs plain text-only chat. Empty = all models get tools
# (the default; current chat + reasoner models all support tool calling).
# Example: VODOU_NO_TOOLS_MODELS=some-old-reasoner,broken-7b
# VODOU_NO_TOOLS_MODELS=

# VODOU_WHOLE_FILE_MODELS -- Comma/space-separated model-id SUBSTRINGS that should
# use WHOLE-FILE rewrites instead of targeted edits (#8 §1.3). Such models are offered
# write_file/read_file/list_dir but NOT edit_file/multi_edit — use for a model that
# can't reliably produce a matchable old_string (over-structuring a weak model
# regresses it). Empty = all models get the targeted-edit tools (default; the
# forgiving applier already tolerates most imprecision).
# Example: VODOU_WHOLE_FILE_MODELS=tiny-1b,some-3b
# VODOU_WHOLE_FILE_MODELS=

# =============================================================================
# ROUTING, MEMORY TUNING & TIMEOUTS (advanced — all optional)
# =============================================================================
# Advanced tuning -- model routing, memory scoring, timeouts. All optional.
#
# Every key below is fully wired and read by shipped code. They were live but
# undocumented, so the Settings -> Environment page filed them under "Other (in
# your .env but not in .env.example)" with no help text. Defaults shown are the
# values used when the key is absent; leave them commented unless you are
# deliberately tuning.

# VODOU_ROUTER_ENABLED -- Turn on the LLM model router (src/router_llm.rs), which
# picks a model per request instead of always using your configured default.
# Default: 0 (off). Set 1 to enable.
# VODOU_ROUTER_ENABLED=0

# VODOU_ROUTER_PROMOTER_ENABLED -- Let the daemon promote a shadow-mode routing
# decision into a real one once it has enough confidence. Only meaningful with
# the router enabled. Default: 0 (off).
# VODOU_ROUTER_PROMOTER_ENABLED=0

# VODOU_ROUTER_V2_SHADOW -- Compare the v2 semantic router against the v1 keyword
# router on every query and log the disagreement. LOG-ONLY: it never changes what
# actually runs. Measured cost 1.3ms average, 55ms worst case. ON BY DEFAULT since
# 0.6.26 -- it is the instrument that shows whether VODOU_ROUTER_ENABLED is worth
# turning on, and that question cannot be answered from one machine.
# Set 0 to opt out.
# VODOU_ROUTER_V2_SHADOW=0

# VODOU_ROUTER_V2_SHADOW_SEMANTIC -- Add EMBEDDING comparison to the shadow above.
# The default shadow path is pure SQLite, which is why it is nearly free; this
# flag makes it compute embeddings per query, so it is materially more expensive.
# Only worth enabling if you are specifically evaluating semantic recall and have
# checked you have latency headroom. Default: 0 (off).
# VODOU_ROUTER_V2_SHADOW_SEMANTIC=0

# VODOU_MEMORY_KEY_FLOOR -- Minimum key-match score before a memory keyword match
# is allowed to boost a search result (src/memory/search.rs). Below the floor the
# boost is zero, which stops weak token overlap from lifting an irrelevant chunk.
# Raise it if search returns loosely-related memories; lower it if it misses
# obvious ones. Default: the built-in memory floor for your embedding model.
# VODOU_MEMORY_KEY_FLOOR=0.35

# VODOU_MEMORY_KEY_BOOST -- Weight applied to a key match that clears the floor
# above. A 0.9 key match at the default weight is worth roughly +0.45 to the
# result's score. Default: 0.5.
# VODOU_MEMORY_KEY_BOOST=0.5

# VODOU_MEMORY_EXTRACT_TIMEOUT_SECS -- Per-request timeout for memory extraction.
# Raise it to drain a large backlog after heavy import or capture activity.
# Accepted range 10-900; values outside it are ignored and the default is used.
# Default: the built-in request timeout.
# VODOU_MEMORY_EXTRACT_TIMEOUT_SECS=120

# VODOU_BRAINLOADER_TIMEOUT_MS -- How long the gateway waits for BrainLoader to
# return context before answering without it. Too low and turns lose memory; too
# high and a stalled lookup delays every reply. Default: 8000 (8s).
# VODOU_BRAINLOADER_TIMEOUT_MS=8000

# VODOU_CAPTURE_IDE_SOURCES -- Comma-separated IDEs whose sessions the passive
# capture daemon ingests into memory. Default: cursor.
# Example: VODOU_CAPTURE_IDE_SOURCES=cursor,claude-code
# VODOU_CAPTURE_IDE_SOURCES=cursor

# VODOU_CHANNEL_ALLOWLIST_ENFORCE -- Fail-CLOSED sender allowlists for channels
# (Slack, Telegram, WhatsApp, ...). DARK BY DEFAULT: unset, a channel with no
# allowlist configured accepts every sender, which keeps existing installs
# working. Set 1 and an unconfigured channel DENIES every sender unless they are
# explicitly listed. Seed your own sender IDs FIRST, then flip this on, or you
# will lock yourself out of your own channels. Accepts 1/true/on/yes.
# Recommended for any install reachable by people you do not control.
# VODOU_CHANNEL_ALLOWLIST_ENFORCE=1

# Require a connected Vodou account (token + user id) for gateway chat.
# 1 = gated (the shipped default intent), 0 = free without an account.
VODOU_REQUIRE_ACCOUNT=1
